{
  "version": "v1",
  "rules": [
    {
      "action_type": "git.pull",
      "environment": "*",
      "allow": true,
      "description": "Read-only git pull is always safe in any environment"
    },
    {
      "action_type": "git.fetch",
      "environment": "*",
      "allow": true,
      "description": "Read-only git fetch is always safe in any environment"
    },
    {
      "action_type": "git.checkout",
      "environment": "*",
      "escalate": true,
      "description": "Git checkout modifies working tree — requires approval to prevent accidental overwrites"
    },
    {
      "action_type": "exec",
      "environment": "*",
      "escalate": true,
      "description": "Direct subprocess execution requires approval in all environments"
    },
    {
      "action_type": "shell",
      "environment": "production",
      "escalate": true,
      "description": "Shell in production requires approval"
    },
    {
      "action_type": "shell",
      "environment": "dev",
      "escalate": true,
      "conditions": {
        "patterns": ["curl |sh", "rm -rf /", "mkfs", ":(){:|:&};"]
      },
      "description": "Dangerous shell patterns in dev escalate for safety review"
    },
    {
      "action_type": "shell",
      "environment": "local",
      "allow": true,
      "description": "Shell in local environment is allowed for development"
    },
    {
      "action_type": "*",
      "environment": "production",
      "escalate": true,
      "conditions": {
        "require_explicit_approval": true
      },
      "description": "Catch-all: all actions in production require explicit approval"
    }
  ]
}
