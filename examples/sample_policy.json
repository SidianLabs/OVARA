{
  "version": "v1",
  "rules": [
    {
      "action_type": "shell",
      "environment": "production",
      "escalate": true
    },
    {
      "action_type": "shell",
      "environment": "dev",
      "escalate": true,
      "conditions": {
        "patterns": ["curl |sh", "rm -rf /", "mkfs", ":(){:|:&};"]
      }
    },
    {
      "action_type": "git.force_push",
      "environment": "*",
      "escalate": true
    },
    {
      "action_type": "git.branch_delete",
      "environment": "*",
      "escalate": true
    },
    {
      "action_type": "github.merge",
      "environment": "*",
      "escalate": true
    },
    {
      "action_type": "*",
      "environment": "production",
      "escalate": true,
      "conditions": {
        "require_explicit_approval": true
      }
    }
  ]
}