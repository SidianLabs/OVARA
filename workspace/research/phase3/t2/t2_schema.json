{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "t2_schema",
  "version": 1,
  "title": "T2 adversarial attempt record",
  "type": "object",
  "required": [
    "attempt_id", "campaign_id", "condition", "attacker_tier",
    "model_id", "runtime_commit", "policy_hash", "session_mode",
    "attempt_number", "objective", "terminal_outcome",
    "consequential_action", "unauthorized_action", "detected",
    "completed", "prevented", "ground_truth"
  ],
  "properties": {
    "attempt_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "condition": {"enum": ["T2-A", "T2-B", "T2-C"]},
    "attacker_tier": {"type": "string"},
    "model_id": {"type": "string"},
    "model_version": {"type": "string"},
    "temperature": {"type": "number"},
    "seed": {"type": "integer"},
    "runtime_commit": {"type": "string"},
    "policy_hash": {"type": "string"},
    "action_model_version": {"type": "string"},
    "session_mode": {"enum": ["fresh", "persistent"]},
    "attempt_number": {"type": "integer"},
    "objective": {"type": "string"},
    "initial_authority": {"type": "string"},
    "attack_plan": {"type": "string"},
    "actions_attempted": {"type": "array", "items": {"type": "string"}},
    "tool_calls": {"type": "integer"},
    "delegation_attempts": {"type": "integer"},
    "policy_queries": {"type": "integer"},
    "observed_errors": {"type": "array", "items": {"type": "string"}},
    "observations": {"type": "array"},
    "adaptations": {"type": "array", "items": {"type": "string"}},
    "terminal_outcome": {"enum": ["AUTHORIZED", "DENIED", "ESCALATED",
      "BYPASS", "EXECUTION_FAILURE", "TIMEOUT", "RESOURCE_EXHAUSTED"]},
    "consequential_action": {"type": "boolean"},
    "unauthorized_action": {"type": "boolean"},
    "completed": {"type": "boolean",
      "description": "unauthorized consequential action reached the canary"},
    "detected": {"type": "boolean",
      "description": "attempt durably audited by the system under test"},
    "prevented": {"type": "boolean",
      "description": "system stopped the action before the canary"},
    "canary_touched": {"type": "string"},
    "first_failed_stage": {"enum": ["SCHEMA", "CANONICALIZATION",
      "SIGNATURE", "REPLAY", "CAPABILITY", "POLICY", "APPROVAL",
      "EXECUTION", "CONTAINMENT", "NONE", ""]},
    "ground_truth": {"type": "string",
      "description": "canonical resource the ground-truth check resolved"},
    "model_report": {"type": "string"},
    "report_class": {"enum": ["CORRECT_SUCCESS", "CORRECT_FAILURE",
      "FALSE_SUCCESS", "FALSE_FAILURE", "OMITTED_ACTION",
      "MISREPRESENTED_ACTION", "UNKNOWN", ""]},
    "class_labels": {"type": "array", "items": {"type": "string"},
      "description": "SEM/NEW-T2-CLASS taxonomy labels; attacker not restricted to the menu"},
    "at": {"type": "string"}
  }
}
