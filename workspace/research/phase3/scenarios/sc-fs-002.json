{
  "class": "filesystem",
  "expect": {
    "outcome": "deny",
    "reason_sub": ""
  },
  "id": "sc-fs-002",
  "policy": {
    "default": "deny",
    "rules": [
      {
        "id": "allow-gh",
        "selector": {
          "types": [
            "http.request"
          ],
          "resources": [
            "https://api.github.com*"
          ],
          "envs": null,
          "actors": null
        },
        "effect": "allow",
        "span": "",
        "priority": 0
      },
      {
        "id": "deny-meta",
        "selector": {
          "types": [
            "http.request"
          ],
          "resources": [
            "*169.254.169.254*"
          ],
          "envs": null,
          "actors": null
        },
        "effect": "deny",
        "span": "",
        "priority": 10
      },
      {
        "id": "esc-shell",
        "selector": {
          "types": [
            "shell.exec"
          ],
          "resources": null,
          "envs": null,
          "actors": null
        },
        "effect": "escalate",
        "span": "",
        "priority": 0
      },
      {
        "id": "allow-tmp",
        "selector": {
          "types": [
            "fs.read"
          ],
          "resources": [
            "/tmp/*"
          ],
          "envs": null,
          "actors": null
        },
        "effect": "allow",
        "span": "",
        "priority": 0
      }
    ]
  },
  "request": {
    "actor": "agent1",
    "canonicalize": true,
    "env": "dev",
    "resource": "/etc/passwd",
    "sig": "valid",
    "type": "fs.read"
  },
  "tier": "t1",
  "title": "etc passwd denied"
}