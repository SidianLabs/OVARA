        "effect": "escalate",
        "span": "",
        "priority": 0
      },
      {
        "id": "allow-tmp",
        "selector": {
          "types": [
            "fs.read"
          ],
          "resources": [
            "/tmp/*"
          ],
          "envs": null,
          "actors": null
        },
        "effect": "allow",
        "span": "",
        "priority": 0
